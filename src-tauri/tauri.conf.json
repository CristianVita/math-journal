{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jurnal Meditatii",
  "version": "0.1.0",
  "identifier": "ro.cristianvita.mathjournal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Jurnal Meditații",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Jurnal pentru meditații de matematică",
    "longDescription": "Jurnal pentru meditații de matematică: elevi, ședințe, formule LaTeX, construcții geometrice, trigonometrie și simboluri matematice.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["Romanian", "English"], "displayLanguageSelector": false }
    }
  }
}
